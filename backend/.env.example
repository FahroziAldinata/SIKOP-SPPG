DATABASE_URL="postgresql://user:password@localhost:5432/dbname"
JWT_SECRET=change-me
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TEST_PASSWORD=change-me
PUPPETEER_EXECUTABLE_PATH=

# Enkripsi API Key Chatbot — AES-256-GCM (wajib diset untuk fitur chatbot)
# Generate dengan: openssl rand -hex 32
# Harus tepat 64 karakter hex (32 byte). JANGAN gunakan key yang sama di prod dan dev.
ENCRYPTION_KEY=ganti-dengan-output-openssl-rand-hex-32

# SMTP — Notifikasi Email (Fase 8). Kosongkan SMTP_HOST untuk menonaktifkan email
# (notifikasi tetap dibuat di in-app, pengiriman email dilewati secara aman).
# 
# CONTOH SETUP:
# 
# # Gmail (App Password required)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=your-email@gmail.com
#
# # Brevo (SendGrid)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-brevo-api-key
# SMTP_PASS=
# SMTP_FROM=noreply@yourdomain.com
#
# # Ethereal (SMTP testing - no password needed)
# SMTP_HOST=smtp.ethereal.email
# SMTP_PORT=587
# SMTP_USER=your-ethereal-email
# SMTP_PASS=your-ethereal-password
# SMTP_FROM=your-ethereal-email
#
# # Custom SMTP
# SMTP_HOST=mail.yourserver.com
# SMTP_PORT=587
# SMTP_USER=your-username
# SMTP_PASS=your-password
# SMTP_FROM=noreply@yourserver.com
#
# Note: 
# - Port 465: secure=true (SSL)
# - Port 587: secure=false (TLS)
# - SMTP_PORT default: 587
# - SMTP_FROM default: SMTP_USER
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
