DATABASE_URL="postgresql://user:password@localhost:5432/dbname"
JWT_SECRET=change-me
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TEST_PASSWORD=change-me
PUPPETEER_EXECUTABLE_PATH=

# Enkripsi API Key Chatbot — AES-256-GCM (wajib diset untuk fitur chatbot)
# Generate dengan: openssl rand -hex 32
# Harus tepat 64 karakter hex (32 byte). JANGAN gunakan key yang sama di prod dan dev.
ENCRYPTION_KEY=ganti-dengan-output-openssl-rand-hex-32
